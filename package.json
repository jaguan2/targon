{
  "name": "targon",
  "private": true,
  "version": "0.1.0",
  "description": "A birth chart, and the distances between signs.",
  "author": "Jason",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/desktop.mjs --dev",
    "build": "tsc -b && vite build",
    "build:web": "npm run build",
    "package:web": "npm run build:web && node scripts/package-web.mjs",
    "preview": "vite preview",
    "preview:web": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:desktop": "node --test scripts/navigation.test.cjs scripts/identity.test.cjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "app": "npm run build:web && node scripts/desktop.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run build:web && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build:web && electron-builder --win --x64 --dir --publish never"
  },
  "build": {
    "appId": "com.jason.star",
    "productName": "Targon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Targon-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Targon-${version}-setup.exe"
    }
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "d3-force": "^3.0.0",
    "luxon": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
