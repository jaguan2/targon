{
  "name": "targon",
  "private": true,
  "version": "0.1.0",
  "description": "A birth chart, and the distances between signs.",
  "author": "Jason",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:web": "npm run dev --workspace frontend -- --host 127.0.0.1",
    "dev:desktop": "node scripts/desktop.mjs --dev",
    "build": "npm run build --workspace frontend",
    "build:web": "npm run build",
    "package:web": "npm run build:web && node scripts/package-web.mjs",
    "preview": "npm run preview --workspace frontend",
    "preview:web": "npm run preview --workspace frontend -- --host 127.0.0.1",
    "test": "npm test --workspace frontend",
    "test:desktop": "node --test scripts/navigation.test.cjs scripts/identity.test.cjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "test:watch": "npm run test:watch --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "app": "npm run build:web && node scripts/desktop.mjs",
    "dist": "npm run dist:win",
    "dist:win": "npm run build:web && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build:web && electron-builder --win --x64 --dir --publish never",
    "smoke:web": "node scripts/smoke-web.mjs"
  },
  "build": {
    "appId": "com.jason.star",
    "productName": "Targon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "frontend/dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Targon-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Targon-${version}-setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "vite": "^6.0.3"
  },
  "workspaces": [
    "frontend"
  ]
}
